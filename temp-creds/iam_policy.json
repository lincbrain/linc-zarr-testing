{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::linc-brain-mit-staging-us-east-2",
        "arn:aws:s3:::linc-brain-mit-staging-us-east-2/*"
      ]
    }
  ]
}